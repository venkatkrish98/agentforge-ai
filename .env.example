# Nebius Token Factory Configuration
# Get your API key from Nebius Token Factory: https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here

# Base URL for Nebius Token Factory OpenAI-compatible API
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Default NVIDIA Model served on Nebius Token Factory
# Options verified: nvidia/Nemotron-3_5-Lightning, nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B, nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# App Port (default 3000)
PORT=3000

# Execution timeout for sandbox test runner (milliseconds)
TEST_RUNNER_TIMEOUT_MS=15000

# Max repair iterations
MAX_REPAIR_ATTEMPTS=3
